# Modo de execução (true grava e-mails em outbox/ e simula SysAid)
DEMO_MODE=true

# Segredo para assinatura dos tokens (gere um valor aleatório forte em produção)
SECRET_KEY=

# Validade do token em segundos (padrão: 900 = 15 minutos)
TOKEN_TTL_SECONDS=900

# URL de retorno para fila humana do Blip
HUMAN_HANDOFF_URL=

# Configuração do Ollama (IA local)
OLLAMA_URL=http://localhost:11434
MODEL_NAME=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30
CONFIDENCE_THRESHOLD=0.60

# E-mail de destino (SysAid abre chamado a partir deste endereço)
EMAIL_TO=atendimento@suaempresa.com.br
EMAIL_FROM=triagem@suaempresa.com.br

# SMTP (usado apenas quando DEMO_MODE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Diretório de saída no modo demonstração
OUTBOX_DIR=outbox

# Rate limit simples (requisições por janela)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# SysAid (para futura integração real: "demo", "api" ou "email")
SYSAID_MODE=demo
SYSAID_API_URL=
SYSAID_API_TOKEN=
